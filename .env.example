# URL del proyecto de Supabase
SUPABASE_URL=https://aidisezaeymiesrdfnza.supabase.co

# Service role key de Supabase. SOLO servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Webhook del flujo padre del scraper de n8n
N8N_SCRAPER_WEBHOOK_URL=http://localhost:5678/webhook/emer-scraper

# Opcional. API key de Google Places (API nueva) para buscar tiendas fisicas con su place_id,
# que es lo que usa la app para la ficha de la tienda. Sin ella, el buscador usa OpenStreetMap
# (coordenadas y direccion, sin place_id).
GOOGLE_PLACES_API_KEY=
